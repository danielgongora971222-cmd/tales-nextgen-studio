{
  "name": "tales---nextgen-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
"scripts": {
  "dev": "concurrently -k -n CLIENT,API -c auto \"npm run dev:client\" \"npm run dev:api\"",
  "build": "vite build",
  "preview": "vite preview",
  "dev:client": "vite",

  "dev:api": "node --import ./server/instrument.mjs server/server.js",
  "dev:worker": "node --import ./server/instrument.mjs server/workers/workerAll.js",

  "start": "SERVE_CLIENT=1 node --import ./server/instrument.mjs server/server.js",
  "start:api": "cross-env SERVE_CLIENT=0 node --import ./server/instrument.mjs server/server.js",

  "start:worker": "node --import ./server/instrument.mjs server/workers/workerAll.js",
  "start:worker:elements": "node --import ./server/instrument.mjs server/workers/klingElementsWorker.js",

  "migrate:storage:r2": "node tools/migrate-storage-to-r2.mjs",
  "preset:wizard": "node tools/preset-wizard/server.mjs",

  "dev:worker:video": "cross-env JOB_KIND=video node --import ./server/instrument.mjs server/workers/jobsWorker.js",
  "dev:worker:image": "cross-env JOB_KIND=image node --import ./server/instrument.mjs server/workers/imageJobsWorker.js",

  "start:worker:video": "node --import ./server/instrument.mjs server/workers/jobsWorker.js",
  "start:worker:image": "node --import ./server/instrument.mjs server/workers/imageJobsWorker.js",

  "loadtest:smoke": "k6 run loadtest/k6-smoke.js",
  "loadtest:spike": "k6 run loadtest/k6-spike.js"
},
  "engines": {
    "node": ">=18"
  },
"dependencies": {
  "@aws-sdk/client-s3": "^3.893.0",
  "@aws-sdk/s3-request-presigner": "^3.893.0",
  "@fal-ai/client": "^1.6.0",
  "@google/genai": "^1.19.0",
  "@react-three/drei": "^10.7.2",
  "@react-three/fiber": "^9.3.0",
  "@sentry/node": "^8.0.0",
  "@sentry/react": "^8.0.0",
  "@supabase/supabase-js": "^2.56.0",
  "@upstash/ratelimit": "^2.0.6",
  "@upstash/redis": "^1.34.4",
  "cors": "^2.8.5",
  "dotenv": "^17.2.3",
  "express": "^4.19.2",
  "express-rate-limit": "^8.1.0",
  "helmet": "^8.0.0",
  "lucide-react": "^0.511.0",
  "multer": "^2.0.2",
  "pino": "^10.1.0",
  "pino-http": "^11.0.0",
  "posthog-js": "^1.258.4",
  "react": "^19.0.0",
  "react-dom": "^19.0.0",
  "react-hot-toast": "^2.4.1",
  "react-router-dom": "^7.2.0",
  "uuid": "^13.0.0",
  "zod": "^4.1.9"
},
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
