{
  "name": "tales---nextgen-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n CLIENT,API -c auto \"npm run dev:client\" \"npm run dev:api\"",
    "build": "vite build",
    "preview": "vite preview",
    "dev:client": "vite",
    "dev:api": "node server/server.js",
    "start": "SERVE_CLIENT=1 node server/server.js",
    "start:api": "SERVE_CLIENT=0 node server/server.js",
    "preset:wizard": "node tools/preset-wizard/server.mjs"
  },

 "dependencies": {
    "@google/genai": "^1.39.0",
    "@supabase/supabase-js": "^2.93.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
