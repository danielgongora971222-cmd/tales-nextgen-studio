+import React, { useEffect, useMemo, useState } from "react";
+import { AppRoute, type Comment } from "../types";
+import {
+  listCommunityListings,
+  getCommunityListing,
+  purchaseCommunityListing,
+  getCommunityListingRecipe,
+  toggleCommunityListingLike,
+  listCommunityListingComments,
+  createCommunityListingComment,
+} from "../services/communityStoreApi";
+import { uploadUserAsset } from "../services/assetsApi";
+
+function HeartIcon({ filled }: { filled: boolean }) {
+  return (
+    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
+      <path
+        fill={filled ? "currentColor" : "none"}
+        stroke="currentColor"
+        strokeWidth="2"
+        d="M12 21s-7-4.6-10-9.3C-0.6 7.3 2.2 3.7 6 4.1c1.6 0.2 3 1.2 4 2.4 1-1.2 2.4-2.2 4-2.4 3.8-0.4 6.6 3.2 4 7.6C19 16.4 12 21 12 21z"
+      />
+    </svg>
+  );
+}
+
+function CommentIcon() {
+  return (
+    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
+      <path
+        fill="none"
+        stroke="currentColor"
+        strokeWidth="2"
+        d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"
+      />
+    </svg>
+  );
+}
+
+type ListingItem = {
+  id: string;
+  name: string;
+  sellerUsername: string;
+  sellerVerified?: boolean;
+  priceCredits: number;
+  description: string;
+  previewUrl: string | null;
+  likesCount: number;
+  commentsCount: number;
+  salesCount: number;
+  likedByMe?: boolean;
+};
+
+interface Props {
+  onNavigate: (route: AppRoute) => void;
+}
+
+type ModalTab = "description" | "comments" | "recipe";
+
+export default function CommunityStore({ onNavigate }: Props) {
+  const [items, setItems] = useState<ListingItem[]>([]);
+  const [offset, setOffset] = useState<number>(0);
+  const [hasMore, setHasMore] = useState<boolean>(true);
+  const [loading, setLoading] = useState<boolean>(false);
+
+  const [selectedId, setSelectedId] = useState<string | null>(null);
+  const [selected, setSelected] = useState<any | null>(null);
+
+  const [busyPurchase, setBusyPurchase] = useState<boolean>(false);
+  const [busyLikeById, setBusyLikeById] = useState<Record<string, boolean>>({});
+
+  const [recipeData, setRecipeData] = useState<any | null>(null);
+  const [recipeResolvedAssets, setRecipeResolvedAssets] = useState<any[]>([]);
+  const [recipeHash, setRecipeHash] = useState<string | null>(null);
+
+  const [modalTab, setModalTab] = useState<ModalTab>("description");
+
+  const [comments, setComments] = useState<Comment[]>([]);
+  const [commentsCount, setCommentsCount] = useState<number>(0);
+  const [commentsLoading, setCommentsLoading] = useState<boolean>(false);
+  const [commentText, setCommentText] = useState<string>("");
+  const [commentBusy, setCommentBusy] = useState<boolean>(false);
+  const [reuseBusy, setReuseBusy] = useState<boolean>(false);
+
+  const [error, setError] = useState<string | null>(null);
+
+  async function loadMore(reset = false) {
+    if (loading) return;
+    setLoading(true);
+    setError(null);
+
+    try {
+      const page = await listCommunityListings({
+        limit: 12,
+        offset: reset ? 0 : offset,
+        sort: "recent",
+        media: "all",
+      });
+
+      const next = (reset ? page.items : [...items, ...page.items]) as ListingItem[];
+
+      setItems(next);
+      setOffset(page.nextOffset);
+      setHasMore(page.hasMore);
+    } catch (e: any) {
+      setError(e?.message || "No se pudo cargar Community Store.");
+    } finally {
+      setLoading(false);
+    }
+  }
+
+  useEffect(() => {
+    loadMore(true);
+  }, []);
+
+  useEffect(() => {
+    if (!selectedId) {
+      setSelected(null);
+      setRecipeData(null);
+      setRecipeResolvedAssets([]);
+      setRecipeHash(null);
+      setModalTab("description");
+      setComments([]);
+      setCommentsCount(0);
+      setCommentText("");
+      return;
+    }
+
+    (async () => {
+      setError(null);
+      setRecipeData(null);
+      setRecipeResolvedAssets([]);
+      setRecipeHash(null);
+
+      try {
+        const item = await getCommunityListing(selectedId);
+        setSelected(item);
+      } catch (e: any) {
+        setError(e?.message || "No se pudo cargar el listing.");
+      }
+    })();
+  }, [selectedId]);
+
+  // Si abriste directo en "Comentarios", carga comentarios cuando ya existe el listing.
+  useEffect(() => {
+    if (!selected?.id) return;
+    if (modalTab !== "comments") return;
+    loadCommentsForSelected();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [selected?.id, modalTab]);
+
+  const selectedIsPurchased = Boolean(selected?.purchasedByMe);
+  const selectedIsOwned = Boolean(selected?.ownedByMe);
+
+  async function handleToggleLike(listingId: string) {
+    setError(null);
+
+    if (busyLikeById[listingId]) return;
+    setBusyLikeById((p) => ({ ...p, [listingId]: true }));
+
+    try {
+      const res = await toggleCommunityListingLike(listingId);
+
+      setItems((prev) =>
+        prev.map((it) => (it.id === listingId ? { ...it, likedByMe: res.liked, likesCount: res.likesCount } : it))
+      );
+
+      setSelected((prev: any) =>
+        prev?.id === listingId ? { ...prev, likedByMe: res.liked, likesCount: res.likesCount } : prev
+      );
+    } catch (e: any) {
+      setError(e?.message || "No se pudo actualizar el Like.");
+    } finally {
+      setBusyLikeById((p) => ({ ...p, [listingId]: false }));
+    }
+  }
+
+  async function handleBuy() {
+    if (!selected?.id) return;
+
+    setBusyPurchase(true);
+    setError(null);
+
+    try {
+      await purchaseCommunityListing(selected.id, null);
+
+      // refresca listing (ventas + flags)
+      const fresh = await getCommunityListing(selected.id);
+      setSelected(fresh);
+
+      // refresca feed (ventas + flags)
+      setItems((prev) =>
+        prev.map((it) =>
+          it.id === selected.id
+            ? {
+                ...it,
+                salesCount: Number(fresh.salesCount) || it.salesCount,
+                priceCredits: Number(fresh.priceCredits) || it.priceCredits,
+              }
+            : it
+        )
+      );
+
+      // ✅ al comprar: muestra receta automáticamente
+      const r = await getCommunityListingRecipe(selected.id);
+      setRecipeData(r.recipe);
+      setRecipeResolvedAssets(r.resolvedAssets || []);
+      setRecipeHash(typeof r.recipeHash === "string" ? r.recipeHash : null);
+      setModalTab("recipe");
+    } catch (e: any) {
+      setError(e?.message || "No se pudo comprar.");
+    } finally {
+      setBusyPurchase(false);
+    }
+  }
+
+  async function handleLoadRecipe() {
+    if (!selected?.id) return;
+
+    setError(null);
+    try {
+      const r = await getCommunityListingRecipe(selected.id);
+      setRecipeData(r.recipe);
+      setRecipeResolvedAssets(r.resolvedAssets || []);
+      setRecipeHash(typeof r.recipeHash === "string" ? r.recipeHash : null);
+      setModalTab("recipe");
+    } catch (e: any) {
+      setError(e?.message || "No se pudo cargar la receta.");
+    }
+  }
+
+  async function loadCommentsForSelected() {
+    if (!selected?.id) return;
+
+    setCommentsLoading(true);
+    setError(null);
+    try {
+      const r = await listCommunityListingComments(selected.id, { limit: 120, offset: 0 });
+      setComments(r.comments);
+      setCommentsCount(r.commentsCount);
+
+      // actualiza contadores en feed/modal
+      setSelected((p: any) => (p?.id === selected.id ? { ...p, commentsCount: r.commentsCount } : p));
+      setItems((prev) => prev.map((it) => (it.id === selected.id ? { ...it, commentsCount: r.commentsCount } : it)));
+    } catch (e: any) {
+      setError(e?.message || "No se pudieron cargar los comentarios.");
+    } finally {
+      setCommentsLoading(false);
+    }
+  }
+
+  async function handleCreateComment() {
+    if (!selected?.id) return;
+
+    const text = (commentText || "").trim();
+    if (!text) return;
+
+    setCommentBusy(true);
+    setError(null);
+    try {
+      const r = await createCommunityListingComment(selected.id, text);
+      setCommentText("");
+
+      // UI: inserta al final (orden asc en backend)
+      setComments((prev) => [...prev, r.comment]);
+      setCommentsCount(r.commentsCount);
+
+      setSelected((p: any) => (p?.id === selected.id ? { ...p, commentsCount: r.commentsCount } : p));
+      setItems((prev) => prev.map((it) => (it.id === selected.id ? { ...it, commentsCount: r.commentsCount } : it)));
+    } catch (e: any) {
+      setError(e?.message || "No se pudo comentar.");
+    } finally {
+      setCommentBusy(false);
+    }
+  }
+
+  async function handleReuseRecipe() {
+    if (!selected?.id) return;
+    if (!recipeData) {
+      setError("Primero carga la receta.");
+      return;
+    }
+
+    const sourceTool = String(recipeData?.sourceAsset?.tool || "");
+
+    // Hoy implementamos el rehuso completo para ImageGeneratorTool.
+    if (sourceTool !== "image-generator") {
+      setError(`Reusar receta aún no está soportado para tool='${sourceTool}'.`);
+      return;
+    }
+
+    const resolved = Array.isArray(recipeResolvedAssets) ? recipeResolvedAssets : [];
+
+    setReuseBusy(true);
+    setError(null);
+
+    try {
+      // ✅ Evita duplicar uploads: cache por recipeHash
+      const cacheKey = recipeHash ? `tales.communityStore.importMap.${recipeHash}` : null;
+      let idMap: Record<string, string> = {};
+      try {
+        if (cacheKey) {
+          const raw = localStorage.getItem(cacheKey);
+          const parsed = raw ? JSON.parse(raw) : null;
+          if (parsed && typeof parsed === "object") idMap = parsed;
+        }
+      } catch {
+        idMap = {};
+      }
+
+      // 1) Importar refs al usuario comprador (para que sean seleccionables en el tool)
+      for (const r of resolved) {
+        const url = typeof r?.url === "string" ? r.url : null;
+        const origId = typeof r?.assetId === "string" ? r.assetId : null;
+        const role = typeof r?.role === "string" ? r.role : "element";
+
+        if (!url || !origId) continue;
+        if (typeof idMap[origId] === "string" && idMap[origId]) continue;
+
+        const resp = await fetch(url);
+        if (!resp.ok) throw new Error(`No se pudo descargar una referencia (${resp.status}).`);
+
+        const blob = await resp.blob();
+        const mime = blob.type || "image/jpeg";
+        const ext = mime.includes("png") ? "png" : mime.includes("webp") ? "webp" : "jpg";
+
+        const tool = role === "element" ? "element-library" : "image-generator-ref";
+        const fileName = `ref_${role}_${Date.now()}.${ext}`;
+        const file = new File([blob], fileName, { type: mime });
+
+        const uploaded = await uploadUserAsset(file, tool);
+        idMap[origId] = uploaded.id;
+      }
+
+      try {
+        if (cacheKey) localStorage.setItem(cacheKey, JSON.stringify(idMap));
+      } catch {
+        // no bloqueamos
+      }
+
+      // 2) Guardar prefill para el tool (robusto aunque cambies de pantalla rápido)
+      const payload = {
+        source: "community-store",
+        recipe: recipeData,
+        idMap,
+        createdAt: Date.now(),
+      };
+
+      localStorage.setItem("tales.prefill.imageGenerator", JSON.stringify(payload));
+      window.dispatchEvent(new CustomEvent("tales:prefill-image-generator", { detail: payload }));
+
+      // 3) Navegar al tool
+      setSelectedId(null);
+      onNavigate(AppRoute.TOOL_GENERATOR);
+    } catch (e: any) {
+      setError(e?.message || "No se pudo reusar la receta.");
+    } finally {
+      setReuseBusy(false);
+    }
+  }
+
+  const feedEmpty = !loading && items.length === 0;
+
+  const modalTitle = useMemo(() => {
+    if (!selected) return "Preview";
+    return selected.name || "Sin nombre";
+  }, [selected]);
+
+  const captionForTile = (it: ListingItem) => {
+    const name = (it.name || "Sin nombre").trim();
+    const desc = (it.description || "").trim();
+    return desc ? `${name} — ${desc}` : name;
+  };
+
+  const TilePill: React.FC<{ children: React.ReactNode }> = ({ children }) => (
+    <span className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/55 border border-white/10 backdrop-blur-md shadow-[0_14px_28px_rgba(0,0,0,0.45)]">
+      {children}
+    </span>
+  );
+
+  const TabBtn: React.FC<{ active: boolean; onClick: () => void; children: React.ReactNode }> = ({ active, onClick, children }) => (
+    <button
+      type="button"
+      onClick={onClick}
+      className={`px-3 py-2 rounded-xl border text-sm font-extrabold transition-all ${
+        active
+          ? "border-[rgba(241,225,148,0.26)] bg-[rgba(241,225,148,0.12)] text-white"
+          : "border-white/10 bg-white/5 text-white/80 hover:bg-white/10"
+      }`}
+    >
+      {children}
+    </button>
+  );
+
+  return (
+    <div className="p-6 text-white">
+      <div className="flex items-end justify-between gap-4 mb-5">
+        <div>
+          <div className="text-2xl font-extrabold tracking-tight">Community Store</div>
+          <div className="text-white/60 text-sm mt-1">
+            Feed con el mismo vibe del historial del ImageGeneratorTool: sin crop, tiles dinámicos, CTA premium.
+          </div>
+        </div>
+
+        <div className="flex gap-2">
+          <button
+            type="button"
+            className="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-sm font-bold"
+            onClick={() => onNavigate(AppRoute.MY_TRADES)}
+          >
+            Ir a My Trades
+          </button>
+
+          <button
+            type="button"
+            className="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-sm font-bold"
+            onClick={() => loadMore(true)}
+            disabled={loading}
+          >
+            {loading ? "Actualizando..." : "Refresh"}
+          </button>
+        </div>
+      </div>
+
+      {error ? <div className="mb-4 text-red-300">{error}</div> : null}
+
+      {feedEmpty ? (
+        <div className="text-white/60">Aún no hay listings en Community Store.</div>
+      ) : (
+        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-4">
+          {items.map((it) => {
+            const liked = Boolean(it.likedByMe);
+
+            return (
+              <div
+                key={it.id}
+                role="button"
+                tabIndex={0}
+                className="group relative rounded-[14px] overflow-hidden border border-white/10 bg-black/20 cursor-pointer transition-all hover:-translate-y-0.5 hover:shadow-[0_18px_44px_rgba(0,0,0,0.60)] hover:border-[rgba(241,225,148,0.18)]"
+                onClick={() => {
+                  setSelectedId(it.id);
+                  setModalTab("description");
+                }}
+                onKeyDown={(e) => {
+                  if (e.key === "Enter" || e.key === " ") {
+                    e.preventDefault();
+                    setSelectedId(it.id);
+                    setModalTab("description");
+                  }
+                }}
+                title="Click para ver preview"
+              >
+                {it.previewUrl ? (
+                  <img className="w-full h-auto block transition-transform duration-500 group-hover:scale-[1.02]" src={it.previewUrl} alt={it.name || "Listing"} loading="lazy" decoding="async" />
+                ) : (
+                  <div className="w-full bg-black/40" style={{ paddingTop: "100%" }} />
+                )}
+
+                {/* Top overlay: creator + purchases */}
+                <div className="absolute top-2 left-2 right-2 flex justify-between gap-2 opacity-80 -translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition pointer-events-none">
+                  <TilePill>
+                    <span className="text-[11px] font-extrabold text-white/95">@{it.sellerUsername}</span>
+                    <span className="text-[10px] font-mono text-[rgba(241,225,148,0.85)]">{it.sellerVerified ? "VERIFIED" : ""}</span>
+                  </TilePill>
+
+                  <TilePill>
+                    <span className="text-[11px] font-extrabold text-white/95">{it.salesCount}</span>
+                    <span className="text-[10px] font-mono text-[rgba(241,225,148,0.85)]">compras</span>
+                  </TilePill>
+                </div>
+
+                {/* Caption (name + short desc) */}
+                <div className="absolute inset-x-0 bottom-0 px-3 pb-[56px] pt-2 bg-gradient-to-t from-black/65 to-transparent opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition pointer-events-none">
+                  <div className="text-sm text-white/95 drop-shadow-[0_2px_10px_rgba(0,0,0,0.55)] line-clamp-2">
+                    {captionForTile(it)}
+                  </div>
+                </div>
+
+                {/* Bottom overlay: like + comments + buy */}
+                <div
+                  className="absolute inset-x-0 bottom-0 p-3 bg-gradient-to-t from-black/80 to-transparent opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition"
+                  onClick={(e) => e.stopPropagation()}
+                >
+                  <div className="grid grid-cols-[1fr_auto_1fr] items-end gap-3">
+                    <div className="flex gap-2 items-center">
+                      <button
+                        type="button"
+                        className={`h-9 px-3 rounded-full border backdrop-blur-md shadow-[0_14px_28px_rgba(0,0,0,0.55)] transition flex items-center gap-2 ${
+                          liked
+                            ? "border-[rgba(241,225,148,0.24)] bg-black/60 text-[rgba(241,225,148,0.98)]"
+                            : "border-white/10 bg-black/55 text-white/95 hover:bg-black/65"
+                        }`}
+                        title={liked ? "Quitar Like" : "Dar Like"}
+                        disabled={Boolean(busyLikeById[it.id])}
+                        onClick={() => handleToggleLike(it.id)}
+                      >
+                        <span className="animate-pulse">
+                          <HeartIcon filled={liked} />
+                        </span>
+                        <span className="text-xs font-extrabold">{it.likesCount}</span>
+                      </button>
+
+                      <button
+                        type="button"
+                        className="h-9 px-3 rounded-full border border-white/10 bg-black/55 text-white/95 hover:bg-black/65 backdrop-blur-md shadow-[0_14px_28px_rgba(0,0,0,0.55)] transition flex items-center gap-2"
+                        title="Comentarios"
+                        onClick={() => {
+                          setSelectedId(it.id);
+                          setModalTab("comments");
+                        }}
+                      >
+                        <CommentIcon />
+                        <span className="text-xs font-extrabold">{it.commentsCount}</span>
+                      </button>
+                    </div>
+
+                    <div className="grid justify-items-center gap-1">
+                      <div className="text-[11px] font-extrabold tracking-wide text-white/90 drop-shadow-[0_6px_22px_rgba(0,0,0,0.60)]">
+                        {it.priceCredits} credits
+                      </div>
+                      <button
+                        type="button"
+                        className="px-4 py-2 rounded-full font-black border border-[rgba(241,225,148,0.28)] bg-[rgba(241,225,148,0.18)] hover:bg-[rgba(241,225,148,0.25)] text-white shadow-[0_18px_36px_rgba(0,0,0,0.55)] transition"
+                        onClick={() => {
+                          setSelectedId(it.id);
+                          setModalTab("description");
+                        }}
+                        title="Abrir preview"
+                      >
+                        Comprar
+                      </button>
+                    </div>
+
+                    <div className="justify-self-end flex gap-2">
+                      <span className="text-xs text-white/85 bg-black/50 border border-white/10 px-3 py-2 rounded-full backdrop-blur-md">❤ {it.likesCount}</span>
+                      <span className="text-xs text-white/85 bg-black/50 border border-white/10 px-3 py-2 rounded-full backdrop-blur-md">💬 {it.commentsCount}</span>
+                    </div>
+                  </div>
+                </div>
+              </div>
+            );
+          })}
+        </div>
+      )}
+
+      {hasMore ? (
+        <div className="mt-6 flex justify-center">
+          <button
