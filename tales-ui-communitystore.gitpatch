+
+                  {modalTab === "comments" ? (
+                    <div className="mt-4 animate-[fadeIn_0.28s_ease-out]">
+                      <div className="text-[12px] font-black tracking-[0.12em] uppercase text-[rgba(241,225,148,0.80)]">
+                        Comentarios ({commentsCount || selected.commentsCount || 0})
+                      </div>
+
+                      {commentsLoading ? <div className="text-white/60 mt-2">Cargando...</div> : null}
+
+                      {!commentsLoading ? (
+                        <div className="mt-3 grid gap-2">
+                          {comments.length ? (
+                            comments.map((c) => (
+                              <div key={c.id} className="rounded-2xl border border-white/10 bg-white/5 p-3">
+                                <div className="text-sm font-extrabold text-white/95">@{c.username}</div>
+                                <div className="mt-2 text-white/75 text-sm whitespace-pre-wrap">{c.text}</div>
+                              </div>
+                            ))
+                          ) : (
+                            <div className="text-white/60 mt-2">Aún no hay comentarios. Sé el primero.</div>
+                          )}
+                        </div>
+                      ) : null}
+
+                      <div className="mt-3 grid gap-2">
+                        <textarea
+                          className="w-full min-h-[74px] resize-y rounded-2xl p-3 border border-white/10 bg-black/30 text-white/95 outline-none focus:border-[rgba(241,225,148,0.26)]"
+                          value={commentText}
+                          onChange={(e) => setCommentText(e.target.value)}
+                          placeholder="Escribe un comentario..."
+                        />
+                        <div className="flex gap-2">
+                          <button
+                            type="button"
+                            className="px-4 py-2 rounded-xl border border-[rgba(241,225,148,0.28)] bg-[rgba(241,225,148,0.20)] hover:bg-[rgba(241,225,148,0.28)] text-white font-extrabold shadow-[0_18px_40px_rgba(0,0,0,0.55)] disabled:opacity-50"
+                            disabled={commentBusy}
+                            onClick={handleCreateComment}
+                          >
+                            {commentBusy ? "Enviando..." : "Comentar"}
+                          </button>
+                        </div>
+                      </div>
+                    </div>
+                  ) : null}
+
+                  {modalTab === "recipe" ? (
+                    <div className="mt-4 animate-[fadeIn_0.28s_ease-out]">
+                      <div className="text-[12px] font-black tracking-[0.12em] uppercase text-[rgba(241,225,148,0.80)]">Receta (desbloqueada)</div>
+
+                      {recipeData ? (
+                        <>
+                          <div className="mt-3 text-white/75 text-sm leading-relaxed">
+                            Esta compra incluye los parámetros completos para re-generar el resultado. Puedes reusar la receta y generar tu propia versión.
+                          </div>
+
+                          <div className="flex flex-wrap gap-2 mt-3">
+                            <button
+                              type="button"
+                              className="px-4 py-2 rounded-xl border border-[rgba(241,225,148,0.28)] bg-[rgba(241,225,148,0.20)] hover:bg-[rgba(241,225,148,0.28)] text-white font-extrabold shadow-[0_18px_40px_rgba(0,0,0,0.55)] disabled:opacity-50"
+                              disabled={reuseBusy}
+                              onClick={handleReuseRecipe}
+                            >
+                              {reuseBusy ? "Importando referencias..." : "Reusar receta"}
+                            </button>
+
+                            <button
+                              type="button"
+                              className="px-4 py-2 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 text-white/90 font-extrabold"
+                              onClick={() => setModalTab("description")}
+                            >
+                              Volver a descripción
+                            </button>
+                          </div>
+
+                          {Array.isArray(recipeResolvedAssets) && recipeResolvedAssets.length ? (
+                            <div className="mt-4">
+                              <div className="text-[12px] font-black tracking-[0.12em] uppercase text-[rgba(241,225,148,0.80)]">Referencias incluidas</div>
+                              <div className="grid grid-cols-3 gap-2 mt-3">
+                                {recipeResolvedAssets
+                                  .filter((r) => typeof r?.url === "string" && r.url)
+                                  .slice(0, 12)
+                                  .map((r, idx) => (
+                                    <div key={`${r.assetId}-${idx}`} className="rounded-2xl overflow-hidden border border-white/10 bg-black/40">
+                                      <img src={r.url} alt={r.role || "ref"} className="w-full h-full object-cover" />
+                                      <div className="px-3 py-2 text-[10px] text-white/70">{r.role}</div>
+                                    </div>
+                                  ))}
+                              </div>
+                            </div>
+                          ) : null}
+
+                          <pre className="mt-4 text-xs bg-black/35 border border-white/10 rounded-2xl p-3 max-h-[280px] overflow-auto">{JSON.stringify(recipeData, null, 2)}</pre>
+                        </>
+                      ) : (
+                        <div className="text-white/60 mt-2">Cargando receta...</div>
+                      )}
+                    </div>
+                  ) : null}
+
+                  {error ? <div className="mt-4 text-red-300">{error}</div> : null}
+                </div>
+              </div>
+            ) : (
+              <div className="p-6 text-white/70">Cargando...</div>
+            )}
+          </div>
+        </div>
+      ) : null}
+
+      {/* Keyframes helper (solo para fadeIn suave) */}
+      <style>{`@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}`}</style>
+    </div>
+  );
+}
