+            if (e.target === e.currentTarget) setSelectedId(null);
+          }}
+        >
+          <div className="w-full max-w-[1120px] rounded-2xl border border-white/10 bg-[rgba(11,11,15,0.92)] shadow-[0_30px_90px_rgba(0,0,0,0.72)] overflow-hidden">
+            <div className="flex items-center justify-between gap-3 px-4 py-3 border-b border-white/10">
+              <div>
+                <div className="text-[13px] font-black tracking-[0.10em] uppercase text-[rgba(241,225,148,0.90)]">Preview</div>
