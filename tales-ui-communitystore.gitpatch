-  description: z.preprocess((v) => (typeof v === "string" ? v.trim() : ""), z.string().max(800)).default(""),
-  listingKind: z.enum(["single", "workflow"]).default("single"),
-});
-
-
-const UpdateListingSchema = z.object({
