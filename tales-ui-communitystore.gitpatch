-  priceCredits: z.preprocess((v) => (v === undefined ? undefined : Number(v)), z.number().int().min(1).max(1000000)).optional(),
-  description: z.preprocess((v) => (v === undefined ? undefined : String(v).trim()), z.string().max(800)).optional(),
