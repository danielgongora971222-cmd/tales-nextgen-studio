-
-    const patch = {};
-    if (body.name != null) patch.name = body.name;
-    if (body.priceCredits != null) patch.price_credits = body.priceCredits;
-    if (body.description != null) patch.description = body.description;
-    if (body.status != null) {
-      patch.status = body.status;
