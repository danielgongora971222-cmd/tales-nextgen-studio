+
+  // ===============================
+  // Prefill desde Community Store
+  // ===============================
+  useEffect(() => {
+    // 1) localStorage (robusto al navegar rápido)
+    try {
+      const raw = localStorage.getItem(PREFILL_KEY);
+      if (raw) {
+        const payload = JSON.parse(raw);
+        localStorage.removeItem(PREFILL_KEY);
+        setPendingExternalPrefill(payload);
+      }
+    } catch {
+      // no bloqueamos
+    }
+
+    // 2) event (útil si el tool ya estaba montado)
+    const onPrefill = (ev: any) => {
+      const payload = ev?.detail;
+      if (!payload) return;
+      setPendingExternalPrefill(payload);
+    };
+
+    window.addEventListener("tales:prefill-image-generator", onPrefill as any);
+    return () => window.removeEventListener("tales:prefill-image-generator", onPrefill as any);
+  }, []);
+
+  // Aplicar prefill cuando ya tenemos myAssets (para que las refs encuentren miniaturas)
+  useEffect(() => {
+    if (!pendingExternalPrefill) return;
+    if (!myAssets.length) return;
+
+    try {
+      const recipe = pendingExternalPrefill?.recipe || null;
+      const idMap = pendingExternalPrefill?.idMap || {};
+
+      const source = recipe?.sourceAsset || {};
+      const rawPrompt = typeof source?.prompt === "string" ? source.prompt : "";
+      const meta = source?.meta && typeof source.meta === "object" ? source.meta : {};
+
+      const mapId = (id: any) => {
+        const k = typeof id === "string" ? id : "";
+        if (!k) return id;
+        return typeof idMap?.[k] === "string" ? idMap[k] : k;
+      };
+
+      const mappedMeta: any = { ...(meta as any) };
+
+      if (Array.isArray(mappedMeta.characterAssetIds)) {
+        mappedMeta.characterAssetIds = mappedMeta.characterAssetIds.map(mapId);
+      }
+
+      if (typeof mappedMeta.backgroundAssetId === "string") {
+        mappedMeta.backgroundAssetId = mapId(mappedMeta.backgroundAssetId);
+      }
+
+      if (typeof mappedMeta.styleAssetId === "string") {
+        mappedMeta.styleAssetId = mapId(mappedMeta.styleAssetId);
+      }
+
+      if (Array.isArray(mappedMeta.promptReferences)) {
+        mappedMeta.promptReferences = mappedMeta.promptReferences.map((r: any) => {
+          const next = { ...(r || {}) };
+          if (typeof next.id === "string") next.id = mapId(next.id);
+          if (typeof next.assetId === "string") next.assetId = mapId(next.assetId);
+          return next;
+        });
+      }
+
+      const fakeAsset: any = {
+        id: `prefill-${Date.now()}`,
+        url: "",
+        type: "image",
+        name: "Prefill",
+        tool: "image-generator",
+        prompt: rawPrompt,
+        createdAt: Date.now(),
+        meta: mappedMeta,
+        ownerId: user?.id || "",
+        isPublic: false,
+        likedByMe: false,
+        likesCount: 0,
+        commentsCount: 0,
+        likes: [],
+        comments: [],
+      };
+
+      // ✅ Reusa la misma lógica que ya existe (model/ratio/count/quality + refs)
+      reusePromptFromAsset(fakeAsset);
+    } catch (e: any) {
+      setError(e?.message || "No se pudo aplicar la receta (prefill)." );
+    } finally {
+      setPendingExternalPrefill(null);
+    }
+  }, [pendingExternalPrefill, myAssets.length]);
